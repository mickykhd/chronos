# Template for the release signing configuration.
#
# Copy this file to `keystore.properties` in the repository root and fill in the
# values for your own key. `keystore.properties` is git-ignored.
#
# Generate a key with:
#
#   keytool -genkeypair -v \
#     -keystore keystore/chronos-release.jks \
#     -alias chronos \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# If this file is absent, the release build falls back to the Android debug key,
# which produces a perfectly installable APK but is not suitable for Play Store
# publishing.

storeFile=keystore/chronos-release.jks
storePassword=CHANGE_ME
keyAlias=chronos
keyPassword=CHANGE_ME
